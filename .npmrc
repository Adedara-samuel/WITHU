# This project lives under a OneDrive-synced folder. pnpm's default symlink-based
# node_modules repeatedly stalls/EPERMs on Windows while OneDrive's sync filter
# driver holds file locks during large installs (observed consistently with the
# Expo/React Native dependency tree, which creates thousands of symlinks). A
# hoisted, npm-style layout avoids that entirely and has proven reliable here.
node-linker=hoisted
shamefully-hoist=true
