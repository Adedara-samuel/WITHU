{
  "expo": {
    "name": "WITHU",
    "slug": "withu",
    "scheme": "withu",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0d1710"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.withu.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0d1710"
      },
      "package": "app.withu.mobile"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-splash-screen",
      "expo-status-bar"
    ],
    "extra": {
      "apiUrl": "http://localhost:4000"
    }
  }
}
